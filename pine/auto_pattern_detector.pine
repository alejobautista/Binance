ml_min_p       = input.float(0.45, "Umbral mínimo p(win)", minval=0.0, maxval=1.0, step=0.01, group=grp_ml)
ml_warm        = input.int(40,     "Trades mínimos antes de filtrar", minval=10, group=grp_ml)
ml_lr          = input.float(0.03, "Learning rate", minval=0.001, maxval=0.5, step=0.001, group=grp_ml)
ml_l2          = input.float(0.002,"Regularización L2", minval=0.0, maxval=0.1, step=0.001, group=grp_ml, tooltip="Penaliza pesos grandes: la principal defensa contra sobreajuste")
ml_balance     = input.bool(true,  "Compensar desbalance win/loss", group=grp_ml, tooltip="Expirar sin llegar a TP1 cuenta como pérdida, así que las derrotas suelen ser mayoría. Sin compensar, el modelo aprende el atajo de decir 'pierde' siempre: acierta mucho y no informa nada. Esto sube el peso de la clase minoritaria (tope 4x)")

string grp_ad = "🎯 TP/SL Adaptativos (MFE/MAE)"
adapt_en       = input.bool(true, "TP adaptativos por cuantiles de MFE",  group=grp_ad)
adapt_min_n    = input.int(20,    "Muestras mínimas para adaptar", minval=10, group=grp_ad)
