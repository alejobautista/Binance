max_latency      = input.int(8,      "Max Latency (bars desde breakout)", minval=1, maxval=50, group=grp_flt, tooltip="Si la detección llega más de N barras después del breakout, el patrón se descarta: el trade ya no existe")

// MEJORA: filtro de tendencia contextual
trend_filter_on  = input.bool(false, "Filtrar por tendencia (EMA)",  group=grp_trn)
