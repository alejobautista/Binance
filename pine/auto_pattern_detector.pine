harvest_depth = input.int(3, "Profundidad de rotación de pivotes", minval=0, maxval=8, group=grp_shadow, tooltip="0 = solo los pivotes más recientes (comportamiento anterior). 3 = también evalúa combinaciones de pivotes más antiguos. Cada nivel multiplica las detecciones y el cómputo")

string grp_smc = "🧬 Contexto Smart Money"
smc_en      = input.bool(true, "Usar features SMC (barrido + estructura)", group=grp_smc)
